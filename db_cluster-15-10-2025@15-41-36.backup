--
-- Name: tasks Users can DELETE own tasks; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Users can DELETE own tasks" ON public.tasks FOR DELETE USING ((auth.uid() = user_id));


--
-- Name: tasks Users can UPDATE own tasks; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Users can UPDATE own tasks" ON public.tasks FOR UPDATE USING ((auth.uid() = user_id)) WITH CHECK ((auth.uid() = user_id));


--
-- Name: task_executions Users can delete own executions; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Users can delete own executions" ON public.task_executions FOR DELETE TO authenticated USING ((auth.uid() = user_id));


--
-- Name: tasks Users can insert own tasks; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Users can insert own tasks" ON public.tasks FOR INSERT WITH CHECK ((auth.uid() = user_id));


--
-- Name: task_executions Users can manage their own executions; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Users can manage their own executions" ON public.task_executions TO authenticated USING ((user_id = auth.uid())) WITH CHECK ((user_id = auth.uid()));


--
-- Name: tasks Users can select own tasks; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Users can select own tasks" ON public.tasks FOR SELECT USING ((auth.uid() = user_id));


